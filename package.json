{
  "name": "civicai",
  "version": "2.0.0",
  "description": "CivicAI - AI-powered civic infrastructure reporting backed by a local MySQL database",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "reset": "node server/seed.js --reset",
    "migrate:sqlite": "node --disable-warning=ExperimentalWarning server/migrate-from-sqlite.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "multer": "^2.4.0",
    "mysql2": "^3.11.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
