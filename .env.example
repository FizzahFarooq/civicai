# Copy this file to ".env" and edit the values.

PORT=3000

# Authority dashboard login (CHANGE THESE)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now

# MySQL database (see README, "Set up MySQL").
# The database is created automatically if the user is allowed to create it.
DB_HOST=localhost
DB_PORT=3306
DB_USER=civicai
DB_PASSWORD=change-this-db-password
DB_NAME=civicai

# Map starting point (latitude, longitude) - set this to your city
MAP_CENTER_LAT=33.6844
MAP_CENTER_LNG=73.0479

# OPTIONAL: turn on real AI photo recognition.
# Leave empty to run in "manual category" mode (everything else still works).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
